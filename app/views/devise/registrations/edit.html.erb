<div class="min-h-screen flex items-center justify-center bg-gray-100">
  <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-md">
    <h2 class="text-2xl font-bold text-center mb-6">Edit <%= resource_name.to_s.humanize %></h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-4">
        <%= f.label :email, class: "block text-gray-700 font-bold mb-2" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input w-full px-3 py-2 border border-gray-300 rounded-md" %>
      </div>

      <div class="field">
        <%= f.label :first_name %><br />
        <%= f.text_field :first_name, autofocus: true, autocomplete: "given-name" %>
      </div>

      <div class="field">
        <%= f.label :last_name %><br />
        <%= f.text_field :last_name, autocomplete: "family-name" %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div class="mb-4 text-sm text-gray-600">Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
      <% end %>

      <div class="mb-4">
        <%= f.label :password, class: "block text-gray-700 font-bold mb-2" %> <i class="text-sm text-gray-500">(leave blank if you don't want to change it)</i>
        <%= f.password_field :password, autocomplete: "new-password", class: "form-input w-full px-3 py-2 border border-gray-300 rounded-md" %>
        <% if @minimum_password_length %>
          <em class="text-xs text-gray-500"><%= @minimum_password_length %> characters minimum</em>
        <% end %>
      </div>

      <div class="mb-4">
        <%= f.label :password_confirmation, class: "block text-gray-700 font-bold mb-2" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input w-full px-3 py-2 border border-gray-300 rounded-md" %>
      </div>

      <div class="mb-4">
        <%= f.label :current_password, class: "block text-gray-700 font-bold mb-2" %> <i class="text-sm text-gray-500">(we need your current password to confirm your changes)</i>
        <%= f.password_field :current_password, autocomplete: "current-password", class: "form-input w-full px-3 py-2 border border-gray-300 rounded-md" %>
      </div>

      <div class="actions mb-4">
        <%= f.submit "Update", class: "bg-blue-600 text-white w-full px-4 py-2 rounded-full hover:bg-blue-700 transition duration-300" %>
      </div>
    <% end %>

    <div class="mt-8 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
      <h3 class="text-xl font-semibold text-center mb-4">Danger</h3>
      <div class="text-center text-black mb-4">
        Click here to permanently <%= button_to "Cancel my account", registration_path(resource_name), data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, method: :delete, class: "bg-red-600 border border-black-300 text-white px-4 py-2 rounded-full hover:bg-red-700 transition duration-300" %>
      </div>
    </div>

    <div class="text-center mt-4">
      <%= link_to "Back", :back, class: "text-blue-600 hover:text-blue-800 transition duration-300" %>
    </div>
  </div>
</div>
