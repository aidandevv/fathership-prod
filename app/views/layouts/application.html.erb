<!DOCTYPE html>
<html>
  <head>
    <title>Fathership</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="shortcut icon" href="<%= asset_path 'use.png' %>" type="image/x-icon">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col bg-slate-50 text-slate-900">
    <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/95 backdrop-blur">
      <nav class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 py-3">
        <%= link_to "Fathership", root_path, class: "text-lg font-semibold tracking-tight" %>

        <div class="flex items-center gap-2">
          <%= link_to "About", about_path, class: "rounded-full px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100" %>
          <%= link_to "Resources", support_path, class: "rounded-full px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100" %>

          <% if user_signed_in? %>
            <%= link_to "Chats", chats_path, class: "rounded-full bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
            <%= link_to "Profile", edit_user_registration_path, class: "rounded-full px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100" %>
            <%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete }, class: "rounded-full bg-rose-600 px-4 py-2 text-sm font-medium text-white hover:bg-rose-700" %>
          <% else %>
            <%= link_to "Log in", new_user_session_path, class: "rounded-full px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100" %>
            <%= link_to "Sign up", new_user_registration_path, class: "rounded-full bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
          <% end %>
        </div>
      </nav>
    </header>

    <%= render "shared/project_banner" %>

    <div id="flash" class="mx-auto w-full max-w-6xl px-4 pt-4">
      <%= render "shared/flash" %>
    </div>

    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-6">
      <%= yield %>
    </main>

    <footer class="border-t border-slate-200 bg-white">
      <div class="mx-auto flex w-full max-w-6xl flex-col gap-2 px-4 py-6 text-sm text-slate-600 md:flex-row md:items-center md:justify-between">
        <p>A father figure, for all who need one.</p>
        <p>&copy; <%= Time.current.year %> Aidan DeVaney</p>
      </div>
    </footer>
  </body>
</html>
