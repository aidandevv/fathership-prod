<!DOCTYPE html>
<html>
  <head>
    <title>Fathership</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="shortcut icon" href="<%= asset_path 'use.png' %>" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex flex-col min-h-screen">
    <p class="notice"><%= notice %></p>
    <p class="alert"><%= alert %></p>

    <!-- Header -->
    <header class="bg-gray-900 text-white py-4">
      <div class="container mx-auto px-4">
        <nav class="flex justify-between items-center">
          <div class="flex items-center">
            <a href="/" class="text-xl font-bold">Fathership</a>
          </div>
          <div class="hidden md:flex space-x-4">
            <!--
            <a href="#" class="hover:text-blue-300 transition duration-300">Home</a>
            <a href="#" class="hover:text-blue-300 transition duration-300">About</a>
            <a href="#" class="hover:text-blue-300 transition duration-300">Features</a>
            <a href="#" class="hover:text-blue-300 transition duration-300">Contact</a>
            -->
          </div>
          <div>
            <% if user_signed_in? %>
              <%= link_to "Log out", destroy_user_session_path, method: :delete, class: "bg-blue-600 text-white px-4 py-2 rounded-full hover:bg-blue-700 transition duration-300" %>
              <%= link_to "Profile", edit_user_registration_path, class: "bg-blue-600 text-white px-4 py-2 rounded-full hover:bg-blue-700 transition duration-300" %>
            <% else %>
              <%= link_to "Sign In", new_user_session_path, class: "bg-blue-600 text-white px-4 py-2 rounded-full hover:bg-blue-700 transition duration-300" %>
              <%= link_to "Sign Up", new_user_registration_path, class: "bg-blue-600 text-white px-4 py-2 rounded-full hover:bg-blue-700 transition duration-300" %>
            <% end %>
          </div>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <div class="flex-grow flex">
      <!-- Sidebar -->
      <div class="w-1/4 bg-dark text-black p-4">
        <h3 class="text-xl font-semibold mb-2">Chats</h3>
        <div class='w-full text-align-center d-flex justify-content-center mt-3'>
          <%= form_with(model: Chat.new) do |form| %>
            <%= form.submit '+ New Chat', class: 'btn btn-dark border-light' if current_user.present? %>
          <% end %>
        </div>
        <div class="mt-3 text-black">
          <h4>Today:</h4>
          <turbo-frame id="user-chats" class="text-black">
            <%= render partial: 'chats/chat_list', collection: current_user.chats.reverse if current_user.present? %>
          </turbo-frame>
        </div>
      </div>
      <!-- Main Chat Content -->
      <div class="w-3/4 bg-white p-4">
        <%= yield %>
      </div>
    </div>

    <footer class="bg-gray-900 text-white py-8">
      <div class="container mx-auto px-4">
        <div class="flex flex-wrap justify-between items-center">
          <div class="w-full md:w-1/3 mb-6 md:mb-0">
            <h3 class="text-xl font-semibold mb-2">Fathership</h3>
            <p class="text-gray-400 text-sm">Your AI companion for every journey</p>
          </div>
          <div class="w-full md:w-1/3 mb-6 md:mb-0">
            <h4 class="text-lg font-medium mb-2">Quick Links</h4>
            <ul class="text-gray-400 text-sm">
            </ul>
          </div>
          <div class="w-full md:w-1/3">
            <h4 class="text-lg font-medium mb-2">Connect</h4>
            <div class="flex space-x-4">
              <%= link_to "#", class: "text-gray-400 hover:text-white transition duration-300" do %>
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"></path></svg>
              <% end %>
              <%= link_to "#", class: "text-gray-400 hover:text-white transition duration-300" do %>
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg>
              <% end %>
            </div>
          </div>
        </div>
        <div class="mt-8 border-t border-gray-800 pt-6 text-center text-sm text-gray-400">
          <p>&copy; <%= Time.current.year %> Aidan DeVaney. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
