<!DOCTYPE html>
<html>
  <head>
    <title>Fathership Chat</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="shortcut icon" href="<%= asset_path 'use.png' %>" type="image/x-icon">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col bg-slate-100 text-slate-900">
    <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/95 backdrop-blur">
      <nav class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 py-3">
        <%= link_to "Fathership", root_path, class: "text-lg font-semibold tracking-tight" %>
        <div class="flex items-center gap-2">
          <%= link_to "About", about_path, class: "rounded-full px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100" %>
          <%= link_to "Resources", support_path, class: "rounded-full px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100" %>
          <%= link_to "Profile", edit_user_registration_path, class: "rounded-full px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100" %>
          <%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete }, class: "rounded-full bg-rose-600 px-4 py-2 text-sm font-medium text-white hover:bg-rose-700" %>
        </div>
      </nav>
    </header>

    <%= render "shared/project_banner" %>

    <div id="flash" class="mx-auto w-full max-w-6xl px-4 pt-4">
      <%= render "shared/flash" %>
    </div>

    <div class="mx-auto flex w-full max-w-6xl flex-1 flex-col gap-4 px-4 pb-6 md:flex-row">
      <aside class="w-full rounded-2xl bg-white p-4 shadow-sm md:sticky md:top-24 md:h-[calc(100vh-8rem)] md:w-80 md:overflow-y-auto">
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Chats</h2>
          <%= form_with(model: Chat.new) do |form| %>
            <%= form.submit "+ New", class: "rounded-full bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
          <% end %>
        </div>

        <turbo-frame id="user-chats">
          <%= render partial: "chats/chat_list", collection: current_user.chats.order(updated_at: :desc).limit(50) %>
        </turbo-frame>
      </aside>

      <main class="min-w-0 flex-1 rounded-2xl bg-white p-3 shadow-sm md:p-4">
        <%= yield %>
      </main>
    </div>
  </body>
</html>
