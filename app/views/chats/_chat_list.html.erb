<div id="<%= dom_id(chat_list, :list) %>" class="mb-2">
  <%= link_to chat_list, data: { turbo_frame: "_top" }, class: "block rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 hover:border-slate-300 hover:bg-slate-100" do %>
    <p class="truncate text-sm font-medium text-slate-800"><%= chat_list.list_name %></p>
    <p class="text-xs text-slate-500"><%= time_ago_in_words(chat_list.updated_at) %> ago</p>
  <% end %>
</div>
