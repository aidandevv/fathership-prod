<!DOCTYPE html>
<html>
<head>
  <title>Unauthorized Access</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload" %>
</head>
<body class="bg-dark text-white flex items-center justify-center min-h-screen">
  <div class="text-center">
    <h1 class="text-4xl font-bold mb-4">Unauthorized Access</h1>
    <h2 class="text-2xl">You do not have permission to access this chat.</h2>
    <p class="text-lg">Please sign out and log in with the correct account.</p>
    <%= link_to 'Back to Home', root_path, class: 'text-blue-500 underline' %>
  </div>
</body>
</html>
