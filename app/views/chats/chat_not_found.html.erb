<!DOCTYPE html>
<html>
<head>
  <title>Chat Not Found</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload" %>
</head>
<body class="bg-dark text-white flex items-center justify-center min-h-screen">
  <div class="text-center">
    <h1 class="text-4xl font-bold mb-4">Chat Not Found</h1>
    <p class="text-lg">The chat you are looking for has been deleted or does not exist.</p>
    <%= link_to 'Back to chats', chats_path, class: 'mt-4 inline-block rounded-full py-3 px-6 bg-gray-100 text-gray-800 font-semibold shadow-lg hover:bg-gray-200 transition duration-300 ease-in-out' %>
  </div>
</body>
</html>
