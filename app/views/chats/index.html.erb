<% if notice %>
  <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
    <span class="block sm:inline"><%= notice %></span>
  </div>
<% end %>

<div class="flex items-center justify-center h-screen">
  <div class="text-center">
    <h2 class="text-gray-700 text-2xl mb-4">Looks like you don't have any chats yet. Let's fix that! Create one by clicking</h2>
    <%= form_with(model: Chat.new, local: true) do |form| %>
      <%= form.submit 'Here', class: 'bg-gradient-to-b from-indigo-800 to-blue-400 text-white px-6 py-3 rounded-lg font-semibold hover:bg-green-600 transition-transform transform hover:scale-105 hover:shadow-2xl cursor-pointer' %>
    <% end %>
  </div>
</div>
