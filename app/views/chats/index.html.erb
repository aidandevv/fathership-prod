<turbo-frame id="current-chat">
  <div class="flex min-h-[60vh] items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-8 text-center">
    <div>
      <h2 class="text-xl font-semibold text-slate-800">No chats yet</h2>
      <p class="mt-2 text-sm text-slate-600">Start your first conversation with one click.</p>
      <%= form_with(model: Chat.new, class: "mt-4") do |form| %>
        <%= form.submit "Start a chat", class: "rounded-full bg-slate-900 px-5 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
      <% end %>
    </div>
  </div>
</turbo-frame>
