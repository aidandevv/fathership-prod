<!-- show.html.erb -->
<p style="color: green"><%= notice %></p>

<div class='flex justify-end mb-2'>
  <%= button_to chat_path(@chat), method: :delete, data: { turbo_confirm: 'Are you sure you want to delete this chat?' }, class: 'flex items-center justify-center bg-red-600 text-white rounded p-2 hover:bg-red-700 transition duration-300' do %>
    <i class="fa fa-trash"></i>
    <span class="ml-2">Delete Chat</span>
  <% end %>
</div>
<%= render 'chat', chat: @chat %>

