<div class="mb-3 flex justify-end">
  <%= button_to chat_path(@chat), method: :delete, data: { turbo_confirm: "Delete this chat?" }, class: "rounded-full bg-rose-600 px-4 py-2 text-sm font-medium text-white hover:bg-rose-700" do %>
    Delete chat
  <% end %>
</div>

<%= render "chat", chat: @chat %>
