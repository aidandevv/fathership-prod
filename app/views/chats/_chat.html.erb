<turbo-frame id="current-chat" class="flex flex-col h-screen">
  <div id="<%= dom_id chat %>" class="flex-1 overflow-y-auto p-4 bg-gray-100">
    <div id="history-area" class="space-y-4">
      <% unless chat.q_and_a.blank? %>
        <% chat.q_and_a.each do |question, answer| %>
          <div class="flex flex-col space-y-2">
            <div class="flex justify-end items-end">
              <div class="bg-blue-500 text-white rounded-lg py-2 px-4 max-w-xs">
                <%= simple_format question, class: "text-sm" %>
              </div>
              <%= image_tag("user.ico", class: "w-8 h-8 rounded-full mr-2", alt: "AI Assistant") %>

            </div>
            <div class="flex justify-start items-end">
              <%= image_tag("father.png", class: "w-8 h-8 rounded-full mr-2", alt: "AI Assistant") %>
              <div class="bg-gray-300 rounded-lg py-2 px-4 max-w-xs">
                <%= simple_format answer, class: "text-sm" %>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <%= form_with(model: chat, class: "p-4 bg-white border-t") do |form| %>
    <div class="flex items-center">
      <%= form.text_field :message, placeholder: '', class: 'flex-1 rounded-full py-2 px-4 bg-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500' %>
      <button type="submit" class="ml-2 bg-blue-500 text-white rounded-full p-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
        </svg>
      </button>
    </div>
  <% end %>
</turbo-frame>