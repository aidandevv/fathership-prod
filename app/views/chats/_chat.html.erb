<turbo-frame id="current-chat">
  <div id="<%= dom_id(chat) %>" data-controller="chat" class="flex h-[calc(100vh-13.5rem)] flex-col rounded-2xl border border-slate-200 bg-slate-50">
    <div id="history-area" data-chat-target="history" class="flex-1 space-y-4 overflow-y-auto p-4">
      <% chat.conversation_pairs.each_with_index do |(question, answer), index| %>
        <div class="space-y-2" id="message_<%= index %>">
          <% if question.present? %>
            <div class="flex justify-end gap-2">
              <div class="max-w-[80%] rounded-2xl rounded-br-sm bg-blue-600 px-4 py-2 text-sm text-white shadow-sm">
                <%= simple_format question, class: "m-0 whitespace-pre-wrap" %>
              </div>
              <%= image_tag("pfp.png", class: "h-8 w-8 rounded-full", alt: "You") %>
            </div>
          <% end %>

          <div class="flex justify-start gap-2">
            <%= image_tag("father.png", class: "h-8 w-8 rounded-full", alt: "Fathership") %>
            <div class="max-w-[80%] rounded-2xl rounded-bl-sm border border-slate-200 bg-white px-4 py-2 text-sm text-slate-800 shadow-sm">
              <%= simple_format answer, class: "m-0 whitespace-pre-wrap" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="border-t border-slate-200 bg-white p-3">
      <div class="mb-2 flex flex-wrap gap-2">
        <% ["I feel stuck today", "Can you help me build confidence?", "How do I calm down right now?"].each do |prompt| %>
          <button type="button" data-chat-target="promptButton" data-action="chat#insertPrompt" data-chat-prompt-param="<%= prompt %>" class="rounded-full border border-slate-300 px-3 py-1 text-xs text-slate-600 hover:border-slate-400 hover:text-slate-900 disabled:cursor-not-allowed disabled:opacity-50">
            <%= prompt %>
          </button>
        <% end %>
      </div>

      <%= form_with(model: chat, class: "flex items-end gap-2", data: { chat_target: "form", action: "turbo:submit-start->chat#submitStart turbo:submit-end->chat#submitEnd" }) do |form| %>
        <div class="flex-1">
          <%= form.text_area :message,
            rows: 1,
            placeholder: "Type your message...",
            maxlength: Chat::MESSAGE_CHAR_LIMIT,
            class: "max-h-40 min-h-12 w-full resize-none rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm leading-6 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200",
            autocomplete: "off",
            required: true,
            data: { chat_target: "input", action: "input->chat#autoResize input->chat#updateCounter input->chat#toggleSend keydown->chat#handleKeydown" } %>
          <div class="mt-1 flex items-center justify-between">
            <p data-chat-target="status" class="text-xs text-slate-500">Press Enter to send. Use Shift+Enter for a new line.</p>
            <p class="text-xs text-slate-500"><span data-chat-target="counter">0</span>/<%= Chat::MESSAGE_CHAR_LIMIT %></p>
          </div>
        </div>

        <button type="submit" data-chat-target="sendButton" class="rounded-2xl bg-blue-600 px-4 py-3 text-sm font-medium text-white shadow-sm transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:bg-blue-300" disabled>
          <span data-chat-target="sendLabel">Send</span>
        </button>
      <% end %>
    </div>
  </div>
</turbo-frame>
