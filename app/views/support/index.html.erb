<%# app/views/home/resources.html.erb %>
<div class="min-h-screen bg-blue-100 py-16 px-6">
  <h1 class="text-4xl font-bold mb-8 text-center">Resources</h1>

  <!-- Social Media Channels Section -->
  <div class="bg-white shadow-md rounded-lg p-6 mb-12">
    <h2 class="text-2xl font-semibold mb-4">Social Media Channels</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
       <div class="mb-4">
        <a href="https://www.youtube.com/channel/UCNepEAWZH0TBu7dkxIbluDw" class="text-blue-500 hover:underline" target="_blank">
          <b>Dad, how do I?</b>
        </a>
        <p class="text-gray-700 text-sm"><b>Dad, how do I?</b> is a YouTube creator who answers common questions for fathers for those who didn't have one.
           He does everything from changing tires to cooking chili, so he's a great resource for common questions and topics.</p>
      </div>
      <div class="mb-4">
        <a href="https://www.youtube.com/@DadAdviceFromBo" class="text-blue-500 hover:underline" target="_blank">
          <b>Dad Advice From Bo</b>
        </a>
        <p class="text-gray-700 text-sm"><b>Bo</b> is much like Dad, how do I? with providing how-to's for home chores with a loving and positive messages ending each video.</p>
      </div>
      <div class="mb-4">
        <a href="https://www.tiktok.com/@purepower34?is_from_webapp=1&sender_device=pc" class="text-blue-500 hover:underline" target="_blank">
          <b>Killer Bee Tactical</b>
        </a>
        <p class="text-gray-700 text-sm"><b>Brent from Killer Bee Tactical</b> provides valuable self defense tips for both digital and physical security.</p>
      </div>
      <div class="mb-4">
        <a href="https://www.youtube.com/channel/UC9hR3DH_UC-mS8XzdmS40qg" class="text-blue-500 hover:underline" target="_blank">
          <b>Your Korean Dad</b>
        </a>
        <p class="text-gray-700 text-sm"><b>Nick Cho</b> is a warm, loving and supportive character who is a great source of encouragement and positive messages.
          Find him on YouTube, Instagram and TikTok.
        </p>
      </div>
      <div class="mb-4">
        <a href="https://www.youtube.com/@scottykilmer" class="text-blue-500 hover:underline" target="_blank">
          <b>Automotive Basics</b>
        </a>
        <p class="text-gray-700 text-sm"><b>Scotty Kilmer</b> is a great resource for car mechanic basics, from general maintenance to fun car mods.</p>
      </div>
      <div class="mb-4">
        <a href="https://www.youtube.com/watch?v=yPAeRiKa0h8" class="text-blue-500 hover:underline" target="_blank">
          <b>Intro to Grilling</b>
        </a>
        <p class="text-gray-700 text-sm"><b>Rick Bayless</b> shows you the basics of grilling -- a great skill to have and improve on.</p>
      </div>
    </div>
  </div>
