  <!-- Books Section -->

  <div class="bg-white shadow-md rounded-lg p-6">
    <h2 class="text-2xl font-semibold mb-4">Books</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="mb-4">
        <a href="https://www.goodreads.com/book/show/6690.Danny_the_Champion_of_the_World" class="text-blue-500 hover:underline" target="_blank">
          <b>Danny the Champion of the World by Rohl Dahl</b>
        </a>
        <p class="text-gray-700 text-sm">This childrens story highlights the importance of having a positive role model, and overcoming adversity.</p>
      </div>
      <div class="mb-4">
        <a href="https://www.goodreads.com/book/show/2657.To_Kill_a_Mockingbird" class="text-blue-500 hover:underline" target="_blank">
          <b>To Kill a Mockingbird by Harper Lee</b>
        </a>
        <p class="text-gray-700 text-sm"> A classic, To Kill a Mockingbird shows the importance of morals and a solid mentor and father figure.</p>
      </div>
      <div class="mb-4">
        <a href="https://www.goodreads.com/book/show/347852.The_Road_Less_Traveled" class="text-blue-500 hover:underline" target="_blank">
          <b>The Road Less Traveled by M. Scott Peck</b>
        </a>
        <p class="text-gray-700 text-sm">This book gives you an insight into your personality and helps you realize you can take control of your life.</p>
      </div>
      
    </div>
  </div>
</div>
