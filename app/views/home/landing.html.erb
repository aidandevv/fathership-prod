<% greeting = case Time.current.hour
when 0..11 then "Good morning"
when 12..17 then "Good afternoon"
else "Good evening"
end %>

<section class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-blue-700 via-blue-600 to-cyan-500 px-6 py-14 text-white shadow-xl md:px-12">
  <div class="absolute -right-10 -top-14 h-40 w-40 rounded-full bg-white/20 blur-3xl"></div>
  <div class="absolute -bottom-20 left-10 h-52 w-52 rounded-full bg-cyan-200/30 blur-3xl"></div>

  <div class="relative grid items-center gap-8 md:grid-cols-2">
    <div>
      <p class="text-sm uppercase tracking-[0.18em] text-blue-100"><%= greeting %><%= ", #{current_user.first_name}" if user_signed_in? && current_user.first_name.present? %></p>
      <h1 class="mt-3 text-4xl font-semibold leading-tight md:text-5xl">A steady, supportive voice whenever you need one.</h1>
      <p class="mt-4 max-w-xl text-base text-blue-100 md:text-lg">
        Fathership is a judgment-free chat companion designed for encouragement, perspective, and practical next steps.
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        <% if user_signed_in? %>
          <%= link_to "Open chats", chats_path, class: "rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-blue-700 hover:bg-blue-50" %>
        <% else %>
          <%= link_to "Create free account", new_user_registration_path, class: "rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-blue-700 hover:bg-blue-50" %>
          <%= link_to "Log in", new_user_session_path, class: "rounded-full border border-white/70 px-5 py-2.5 text-sm font-semibold text-white hover:bg-white/10" %>
        <% end %>
      </div>
    </div>

    <div class="mx-auto w-full max-w-md rounded-2xl border border-white/25 bg-white/10 p-2 backdrop-blur">
      <%= image_tag "use.png", alt: "Fathership preview", class: "w-full rounded-xl" %>
    </div>
  </div>
</section>

<section class="mt-8 grid gap-4 md:grid-cols-3">
  <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Personalized</h2>
    <p class="mt-2 text-sm text-slate-700">Conversations adapt to your context so each response feels relevant and grounded.</p>
  </article>

  <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Private by default</h2>
    <p class="mt-2 text-sm text-slate-700">Built with a minimal surface area and straightforward account controls.</p>
  </article>

  <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Always available</h2>
    <p class="mt-2 text-sm text-slate-700">Check in anytime for support, reflection, or a practical next step.</p>
  </article>
</section>

<section class="mt-8 grid gap-4 md:grid-cols-2">
  <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <h3 class="text-xl font-semibold text-slate-900">See the story behind the app</h3>
    <p class="mt-2 text-sm text-slate-600">Learn why this project exists and how it is evolving.</p>
    <%= link_to "About Fathership", about_path, class: "mt-4 inline-block rounded-full bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
  </article>

  <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <h3 class="text-xl font-semibold text-slate-900">Find extra resources</h3>
    <p class="mt-2 text-sm text-slate-600">Explore recommended channels and reading that complement chat support.</p>
    <%= link_to "Open resources", support_path, class: "mt-4 inline-block rounded-full bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
  </article>
</section>
