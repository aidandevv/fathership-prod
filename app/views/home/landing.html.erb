<!-- app/views/pages/home.html.erb -->
<div class="bg-gradient-to-b from-indigo-800 to-blue-400 min-h-screen">
  <!-- Hero Section -->
  <header class="container mx-auto px-4 py-16 text-white">
    <div class="flex flex-col md:flex-row items-center justify-between">
      <div class="md:w-1/2 mb-8 md:mb-0">
        <h1 class="text-4xl md:text-6xl font-bold mb-4">Welcome to Fathership</h1>
        <p class="text-xl mb-8">Your AI companion for every journey in life</p>
        <%= link_to "Get Started", chats_path, class: "bg-white text-blue-600 px-6 py-3 rounded-full font-semibold hover:bg-blue-100 transition duration-300" %>
      </div>
      <div class="md:w-1/2">
        <%= image_tag 'use.png', alt: 'Fathership AI', class: 'rounded-lg shadow-xl' %>
      </div>
    </div>
  </header>

  <div class="flex flex-col md:flex-row items-center justify-center">
    <h1 class=" text-white text-4xl md:text-6xl font-bold mb-4">A father figure, for <span class="gradient-text">all</span> who need him</h1>
  </div>

  <div class="max-w-4xl mx-auto px-4 py-8">
  
  <div class="space-y-6">
    <div>
      <div class="flex items-center mb-2">
        <span class="text-3xl mr-2">🧠</span>
        <h3 class="text-xl font-semibold">Intelligent Conversations</h3>
      </div>
      <p>Engage in meaningful dialogues with our advanced AI.</p>
    </div>

    <div>
      <div class="flex items-center mb-2">
        <span class="text-3xl mr-2">🌟</span>
        <h3 class="text-xl font-semibold">Personalized Experience</h3>
      </div>
      <p>Tailored interactions based on your unique needs and preferences.</p>
    </div>

    <div>
      <div class="flex items-center mb-2">
        <span class="text-3xl mr-2">🔒</span>
        <h3 class="text-xl font-semibold">Privacy Focused</h3>
      </div>
      <p>Your conversations are always private and secure.</p>
    </div>
  </div>
</div>
<%= yield %>
  <!-- Call to Action -->
  <section class=" py-16 border-spacing-1">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Ready to start your journey?</h2>
      <p class="text-xl mb-8">Join thousands of users benefiting from Fathership's AI companion.</p>
      <a href="#" class="bg-white text-blue-700 px-8 py-3 rounded-full font-semibold hover:bg-blue-100 transition duration-300">Sign Up Now</a>
    </div>
  </section>
</div>
