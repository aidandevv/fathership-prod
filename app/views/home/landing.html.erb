<!-- app/views/pages/home.html.erb -->
<div class="bg-gradient-to-b from-indigo-800 to-blue-400 min-h-screen">
  <!-- Hero Section -->
  <header class="container mx-auto px-4 py-16 text-white">
    <div class="flex flex-col md:flex-row items-center justify-between">
      <div class="md:w-1/2 mb-8 md:mb-0">
        <h1 id="greeting" class="text-4xl md:text-6xl font-bold mb-4">Hey there, champ</h1>
        <p id="welcome" class="text-xl mb-8">Welcome to Fathership, we're glad to see you.</p>
        <%= link_to "Get Started", new_user_registration_path, class: "bg-white text-blue-600 px-6 py-3 mr-4 rounded-full font-semibold hover:bg-blue-100 transition duration-300" %>
        <% unless user_signed_in? %>
          <%= link_to "Log In", new_user_session_path, class: "bg-white text-blue-600 px-6 py-3 rounded-full font-semibold hover:bg-blue-100 transition duration-300" %>
        <% end %>
      </div>
      <div class="md:w-1/2">
        <%= image_tag 'use.png', alt: 'Fathership AI', class: 'rounded-lg shadow-xl' %>
      </div>
    </div>
  </header>

<div class="father-figure-container">
  <h1 class="father-figure-text">
    <span>A father figure, for</span><span class="gradient-text-all">all</span><span>who need him</span>
  </h1>
</div>

  <!-- App Demos -->

  <!-- Shaving -->
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="flex flex-col md:flex-row items-center justify-between">
      <div class="md:w-1/2">
        <h1 class="text-white text-xl md:text-5xl font-bold mb-4">Ask any questions you have, <span class="text-indigo-900 text-7xl">judgement free</span></h1>
      </div>
      <div class="md:w-3/4">
        <div class="ml-8 rounded-lg shadow-lg overflow-hidden">
          <%= image_tag 'shave-trans.png', alt: 'App Functionality Example', class: 'w-full rounded-lg' %>
        </div>
      </div>
    </div>
  </div>

  <!-- Advice -->
  <div class="max-w-6xl mx-auto px-8 py-12">
    <div class="flex flex-col md:flex-row items-center justify-between">
      <div class="md:w-11/12">
        <div class="mr-8 rounded-lg shadow-lg overflow-hidden">
          <%= image_tag 'advice2.png', alt: 'App Functionality Example', class: 'w-full rounded-lg' %>
        </div>
      </div>
      <div class="md:w-1/2">
        <h1 class="text-white text-2xl md:text-5xl font-bold mb-4">Advice for your <span class="text-indigo-900 text-7xl text-outline">big</span> moments</h1>
      </div>
    </div>
  </div>

  <!-- Support -->
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="flex flex-col md:flex-row items-center justify-between">
      <div class="md:w-1/2">
        <h1 class="text-white text-2xl md:text-5xl font-bold mb-4">A <span class="text-indigo-900 text-6xl">helping hand</span> to guide you in times of need</h1>
      </div>
      <div class="md:w-11/12">
        <div class="ml-8 rounded-lg shadow-lg overflow-hidden">
          <%= image_tag 'support2.png', alt: 'App Functionality Example', class: 'w-full rounded-lg' %>
        </div>
      </div>
    </div>
  </div>


  <!-- End App Demos -->
  <div class="max-w-4xl mx-auto px-4 py-8">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-24">
    <div class="flex flex-col items-center text-center">
      <div class="flex items-center mb-2">
        <i class="fa fa-user-circle fa-2x text-indigo-900" aria-hidden="true"></i>
        <h3 class="ml-2 text-xl font-semibold"> Personalized Experience</h3>
      </div>
      <p>Tailored, OpenAI-powered interactions are based on your unique needs and preferences. Talk as little or as much as you want, Fathership is here for you.</p>
    </div>

    <div class="flex flex-col items-center text-center">
      <div class="flex items-center mb-2">
        <i class="fa fa-lock fa-2x text-indigo-900" aria-hidden="true"></i>
        <h3 class="ml-2 text-xl font-semibold">Privacy Focused</h3>
      </div>
      <p>Your conversations are always private and secure. Your conversations stay between you and Fathership.</p>
    </div>

    <div class="flex flex-col items-center text-center">
      <div class="flex items-center mb-2">
        <i class="fa fa-comments fa-2x text-indigo-900" aria-hidden="true"></i>
        <h3 class="ml-2 text-xl font-semibold">Natural Feel</h3>
      </div>
      <p>Fathership is designed to feel like you are texting your role model, letting you focus on what to say instead of how.</p>
    </div>

    <div class="flex flex-col items-center text-center">
      <div class="flex items-center mb-2">
        <i class="fa fa-credit-card-alt fa-2x text-indigo-900" aria-hidden="true"></i>
        <h3 class="ml-2 text-xl font-semibold">Free, Forever</h3>
      </div>
        <p>
          Fathership is a service that aims to be free forever: we don't ask for any payment to sign up. 
          However, as a student-run project, donations are appreciated! 
          Check the <b><%= link_to 'About', about_path, class: 'text-indigo-900' %></b> page to see how you can help.
        </p>
    </div>
  </div>
</div>



  <%= yield %>

<div class="container mx-auto px-4 text-center flex justify-between space-x-1 items-stretch">
  <section class="py-16 border-spacing-1 flex-1 flex">
    <div class="bg-white bg-opacity-15 shadow-lg rounded p-8 transition-transform transform hover:scale-105 hover:shadow-2xl flex flex-col justify-between">
      <div>
        <h2 class="text-3xl font-bold mb-4">See Behind the Scenes!</h2>
        <p class="text-xl mb-8">Meet the student creator and the story behind Fathership below.</p>
      </div>
      <%= link_to 'Show Me', about_path, class: 'bg-white text-blue-700 px-8 py-3 rounded-full font-semibold hover:bg-blue-100 transition duration-300' %>
    </div>
  </section>

  <section class="py-16 border-spacing-1 flex-1 flex">
    <div class="bg-white bg-opacity-15 shadow-lg rounded p-8 transition-transform transform hover:scale-105 hover:shadow-2xl flex flex-col justify-between">
      <div>
        <h2 class="text-3xl font-bold mb-4">Explore Free Resources</h2>
        <p class="text-xl mb-8">Check out a collection of articles, social media channels, and helpful links for resources on fatherly information.</p>
      </div>
      <%= link_to 'Let\'s go', support_path, class: 'bg-white text-blue-700 px-8 py-3 rounded-full font-semibold hover:bg-blue-100 transition duration-300' %>
    </div>
  </section>
</div>



  <!-- Call to Action -->
<% unless user_signed_in? %>
  <section class="py-16 border-spacing-1">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Ready to start your conversation?</h2>
      <p class="text-xl mb-8">Join those already benefiting from Fathership's support.</p>
      <%= link_to 'Sign Up Now', new_user_registration_path, class: 'bg-white text-blue-700 px-8 py-3 rounded-full font-semibold hover:bg-blue-100 transition duration-300' %>
    </div>
  </section>
</div>
  </div>
<% end %>


<script>
    document.addEventListener('DOMContentLoaded', function() {
    var greetingElement = document.getElementById('greeting');
    var now = new Date();
    var hours = now.getHours();
    var greeting;

    if (hours < 12) {
      greeting = 'Hi! Good morning';
    } else if (hours < 18) {
      greeting = 'Hey there, good afternoon';
    } else if (hours < 20) {
      greeting = 'Good evening';
    } else {
      greeting = 'Hey, up late?';
    }

    <% if user_signed_in? %>
      var firstName = "<%= current_user.first_name %>";
      if (hours < 20) {
        greetingElement.innerText = greeting + ' ' + firstName + '!';
      } else {
        greetingElement.innerText = 'Hey, up late ' + firstName + '?';
      }
    <% else %>
      greetingElement.innerText = greeting;
    <% end %>
  });

    document.addEventListener('DOMContentLoaded', function() {
      var greetingElement = document.getElementById('welcome');
      <% if user_signed_in? %>
        greetingElement.innerText = 'Welcome back to Fathership!';
      <% else %>
        greetingElement.innerText = 'Welcome to Fathership, we\'re glad to see you!';
      <% end %>
      });
  </script>
