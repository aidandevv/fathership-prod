# Rails
RAILS_ENV=development
RAILS_MAX_THREADS=5
SECRET_KEY_BASE=replace-me-in-production
RAILS_SERVE_STATIC_FILES=1

# Database (local Docker defaults)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DBUSER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fathership_development
POSTGRES_TEST_DB=fathership_test

# Optional OpenAI configuration
OPENAI_ACCESS_TOKEN=
OPENAI_MODEL=gpt-5-nano
OPENAI_MAX_TOKENS=260
OPENAI_TEMPERATURE=0.6
OPENAI_REQUEST_TIMEOUT=18
OPENAI_RETRY_COUNT=2
OPENAI_RETRY_BASE_DELAY=0.35
CHAT_CONTEXT_TURN_LIMIT=8
CHAT_MESSAGE_CHAR_LIMIT=700
